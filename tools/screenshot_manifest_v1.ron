// Headless screenshot manifest — baseline v1.
//
// Loaded by `cargo run --bin screenshot -- --manifest tools/screenshot_manifest_v1.ron`.
// Writes PNGs to `docs/UI/baselines/v1/{name}.png`.
//
// The 14 entries mirror the screenshots originally pasted into GRA-52.
// Three additional entries (personnel, intel, diplomacy) cover menus
// that the original 14 missed. Submenu entries (Construction: buildings
// / ships / defenses, Research: tech tree / available / engineering,
// Economy: logistics / mining / resources / stockpiles / statistics)
// belong in `screenshot_manifest_v1.1.ron` — see GRA-60.
//
// `wait_frames` is the number of frames to idle after switching the menu
// before triggering the capture. The default is 60 (1 s at 60 fps);
// heavy panels (Construction, Research) get bumped to 120.

ScreenshotManifest(
    version: "1.0",
    out_dir: "docs/UI/baselines/v1",
    entries: [
        // --- Top-level menus (11) ---
        ManifestEntry(name: "01_main",           menu: "main",          wait_frames: 60),
        ManifestEntry(name: "02_survey",         menu: "survey",        wait_frames: 90),
        ManifestEntry(name: "03_starmap",        menu: "starmap",       wait_frames: 90),
        ManifestEntry(name: "04_construction",   menu: "construction",  wait_frames: 120),
        ManifestEntry(name: "05_research",       menu: "research",      wait_frames: 120),
        ManifestEntry(name: "06_fleets",         menu: "fleets",        wait_frames: 90),
        ManifestEntry(name: "07_shipbuilding",   menu: "shipbuilding",  wait_frames: 120),
        ManifestEntry(name: "08_economy",        menu: "economy",       wait_frames: 90),
        ManifestEntry(name: "09_personnel",      menu: "personnel",     wait_frames: 90),
        ManifestEntry(name: "10_intel",          menu: "intel",         wait_frames: 90),
        ManifestEntry(name: "11_diplomacy",      menu: "diplomacy",     wait_frames: 90),
    ],
)
