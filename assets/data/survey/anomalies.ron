            detection_threshold: 2,
            false_positive_rate: 0.10,
            activation_threshold: 0.7,
            evidence_methods: [RemoteSensing, SurfaceLander, Drill],
            method_specificity: {SurfaceLander: 0.85, Drill: 1.0},
            effect: (kind: "unlocks_building", building_id: "WaterExtractor"),
            coolness: 0.6,
