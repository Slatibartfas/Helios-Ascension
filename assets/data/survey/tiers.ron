        (
            id: "OrbitalMech_t3",
            dimension: OrbitalMech,
            tier: 3,
            description: "+ moons, libration.",
            unlocks: ["moon_targeting_unlocked"],
        ),
        (
            id: "OrbitalMech_t4",
            dimension: OrbitalMech,
            tier: 4,
            description: "+ dust/torus.",
            unlocks: [],
        ),
        (
            id: "OrbitalMech_t5",
            dimension: OrbitalMech,
            tier: 5,
            description: "Full ephemeris.",
            unlocks: ["high_precision_navigation"],
        ),

