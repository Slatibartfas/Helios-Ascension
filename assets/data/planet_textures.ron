// Planet Texture Manifest
//
// This file maps planet-type categories to lists of texture paths.
// All paths are relative to the `assets/` directory.
//
// MODDING GUIDE
// =============
// To add your own textures for a planet type:
//
//   1. Place your texture file in the matching subfolder under
//      `assets/textures/celestial/planets/<category>/`
//      (or anywhere else inside `assets/`).
//
//   2. Add the path to the appropriate category list below.
//      Example — adding a custom jungle texture:
//
//      "jungle": [
//          "textures/celestial/planets/jungle/my_jungle_planet.jpg",  // <-- add here
//          "textures/celestial/planets/earth_8k.jpg",
//      ],
//
//   3. Restart the game. The new texture will be used automatically.
//
// The game picks textures DETERMINISTICALLY by body name, so each planet
// always gets the same texture across sessions. Adding more textures gives
// more variety without breaking reproducibility.
//
// CATEGORIES
// ==========
//   barren     — Dry, rocky, mostly neutral-toned worlds (Mercury-like)
//   rock       — Bare stony and mineral-rich rocky worlds
//   martian    — Rust-red oxidised rocky worlds (Mars-like)
//   scorched   — Extreme-heat greenhouse worlds: 200°C – 500°C (Venus-like)
//   desert     — Hot sandy worlds: 60°C – 200°C  (dunes / mesas / sparse water)
//   temperate  — Mixed biome Earth-like worlds: -20°C – 60°C
//   jungle     — Lush, heavily-vegetated worlds: -20°C – 60°C
//   ocean      — Global-ocean-dominated worlds:  -20°C – 60°C
//   tundra     — Cold permafrost worlds: -100°C – -20°C
//   ice        — Deeply-frozen worlds below -100°C (Pluto-like)
//   lava       — Volcanically-active molten worlds above 500°C
//   gas_giant  — H/He dominated gas giants (Jupiter / Saturn -like)
//   ice_giant  — Ice giants rich in water/ammonia/methane ices (Neptune / Uranus -like)
//   dwarf      — Dwarf planets and Kuiper Belt Objects
//   moon       — Natural satellites
//   asteroid_s — Silicaceous / metallic / basaltic asteroids
//   asteroid_c — Carbonaceous / dark primitive asteroids
//   comet      — Cometary nuclei

(
    categories: {
        // ── Rocky terrestrial worlds ─────────────────────────────────────────
        "barren": [
            // Dry neutral-toned rocky worlds. Add barren planet textures to
            // assets/textures/celestial/planets/barren/ and register them here.
            "textures/celestial/planets/mercury_8k.jpg",
            "textures/celestial/planets/barren/barren_01.png",
            "textures/celestial/planets/barren/barren_02.png",
            "textures/celestial/planets/barren/barren_03.png",
            "textures/celestial/planets/barren/barren_04.png",
            "textures/celestial/planets/barren/barren_05.png",
            "textures/celestial/planets/barren/barren_06.png",
        ],
        "rock": [
            // Bare stony and mineral-rich worlds. Add rock planet textures to
            // assets/textures/celestial/planets/rock/ and register them here.
            "textures/celestial/planets/mercury_8k.jpg",
            "textures/celestial/planets/rock/rock_01.png",
            "textures/celestial/planets/rock/rock_02.png",
            "textures/celestial/planets/rock/rock_03.png",
            "textures/celestial/planets/rock/rock_04.png",
            "textures/celestial/planets/rock/rock_05.png",
            "textures/celestial/planets/rock/rock_06.png",
        ],
        "martian": [
            // Rust-red oxidised rocky worlds. Add martian textures to
            // assets/textures/celestial/planets/martian/ and register them here.
            "textures/celestial/planets/mars_8k.jpg",
            "textures/celestial/planets/martian/martian_01.png",
            "textures/celestial/planets/martian/martian_02.png",
            "textures/celestial/planets/martian/martian_03.png",
            "textures/celestial/planets/martian/martian_04.png",
            "textures/celestial/planets/martian/martian_05.png",
        ],
        "desert": [
            // Hot, sandy arid worlds (60–200 °C) with dunes, mesas, and sparse
            // traces of surface water.
            "textures/celestial/planets/desert/desert_01.png",
            "textures/celestial/planets/desert/desert_02.png",
            "textures/celestial/planets/desert/desert_03.png",
            "textures/celestial/planets/desert/desert_04.png",
            "textures/celestial/planets/desert/desert_05.png",
            "textures/celestial/planets/desert/desert_06.png",
            "textures/celestial/planets/desert/desert_07.png",
            "textures/celestial/planets/desert/desert_08.png",
        ],
        "temperate": [
            // Earth-like mixed biome worlds. Add temperate planet textures to
            // assets/textures/celestial/planets/temperate/ and register them here.
            "textures/celestial/planets/earth_8k.jpg",
        ],
        "jungle": [
            // Lush, heavily vegetated worlds. Add jungle planet textures to
            // assets/textures/celestial/planets/jungle/ and register them here.
            // Currently uses Earth as a placeholder — replace with dedicated textures.
            "textures/celestial/planets/earth_8k.jpg",
        ],
        "ocean": [
            // Global-ocean worlds. Add ocean planet textures to
            // assets/textures/celestial/planets/ocean/ and register them here.
            // Currently uses Earth as a placeholder — replace with dedicated textures.
            "textures/celestial/planets/earth_8k.jpg",
        ],
        "alpine": [
            "textures/celestial/planets/alpine/Alpine.png",
        ],
        "savannah": [
            "textures/celestial/planets/savannah/Savannah.png",
        ],
        "swamp": [
            "textures/celestial/planets/swamp/Swamp.png",
        ],
        "tundra": [
            // Cold permafrost worlds. Add tundra planet textures to
            // assets/textures/celestial/planets/tundra/ and register them here.
            "textures/celestial/planets/pluto_8k.png",
            "textures/celestial/planets/mars_8k.jpg",
        ],
        "ice": [
            // Deeply frozen worlds. Add ice planet textures to
            // assets/textures/celestial/planets/ice/ and register them here.
            "textures/celestial/planets/pluto_8k.png",
            "textures/celestial/planets/eris_2k.jpg",
            "textures/celestial/planets/ice/Icy.png",
            "textures/celestial/planets/ice/ice_01.png",
            "textures/celestial/planets/ice/ice_02.png",
            "textures/celestial/planets/ice/ice_03.png",
            "textures/celestial/planets/ice/ice_04.png",
            "textures/celestial/planets/ice/ice_05.png",
            "textures/celestial/planets/ice/ice_06.png",
            "textures/celestial/planets/ice/ice_07.png",
            "textures/celestial/planets/ice/ice_08.png",
        ],
        "lava": [
            // Volcanically active worlds with molten surfaces (>500°C).
            // Includes the dedicated volcanic textures added under
            // assets/textures/celestial/planets/lava/.
            "textures/celestial/planets/mercury_8k.jpg",
            "textures/celestial/planets/venus_surface_8k.jpg",
            "textures/celestial/planets/lava/Volcanic.png",
            "textures/celestial/planets/lava/lava_01.png",
            "textures/celestial/planets/lava/lava_02.png",
            "textures/celestial/planets/lava/lava_03.png",
            "textures/celestial/planets/lava/lava_04.png",
            "textures/celestial/planets/lava/lava_05.png",
            "textures/celestial/planets/lava/lava_06.png",
            "textures/celestial/planets/lava/lava_07.png",
            "textures/celestial/planets/lava/lava_08.png",
        ],
        "scorched": [
            // Extreme-heat greenhouse worlds (200–500°C, Venus-like).
            // Add scorched planet textures to
            // assets/textures/celestial/planets/scorched/ and register them here.
            "textures/celestial/planets/venus_surface_8k.jpg",
            "textures/celestial/planets/mercury_8k.jpg",
        ],

        // ── Giant planets ────────────────────────────────────────────────────
        "gas_giant": [
            // Warm gas giants. Add gas giant textures to
            // assets/textures/celestial/planets/gas_giant/ and register them here.
            "textures/celestial/planets/jupiter_8k.jpg",
            "textures/celestial/planets/saturn_8k.jpg",
            "textures/celestial/planets/gas_giant/gas_giant_01.png",
            "textures/celestial/planets/gas_giant/gas_giant_02.png",
            "textures/celestial/planets/gas_giant/gas_giant_03.png",
            "textures/celestial/planets/gas_giant/gas_giant_04.png",
            "textures/celestial/planets/gas_giant/gas_giant_05.png",
            "textures/celestial/planets/gas_giant/gas_giant_06.png",
            "textures/celestial/planets/gas_giant/gas_giant_07.png",
            "textures/celestial/planets/gas_giant/gas_giant_08.png",
            "textures/celestial/planets/gas_giant/gas_giant_09.png",
            "textures/celestial/planets/gas_giant/gas_giant_10.png",
            "textures/celestial/planets/gas_giant/gas_giant_11.png",
            "textures/celestial/planets/gas_giant/gas_giant_12.png",
            "textures/celestial/planets/gas_giant/gas_giant_13.png",
