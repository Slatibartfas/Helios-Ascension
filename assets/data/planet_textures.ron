            "textures/celestial/planets/gas_giant/gas_giant_17.png",
            "textures/celestial/planets/gas_giant/gas_giant_18.png",
            "textures/celestial/planets/gas_giant/gas_giant_19.png",
            "textures/celestial/planets/gas_giant/gas_giant_20.png",
        ],
        "ice_giant": [
            // Cold ice giants. Add ice giant textures to
            // assets/textures/celestial/planets/ice_giant/ and register them here.
            "textures/celestial/planets/neptune_2k.jpg",
            "textures/celestial/planets/uranus_2k.jpg",
        ],

        // ── Small bodies ─────────────────────────────────────────────────────
        "dwarf": [
            // Dwarf planets and KBOs. Add textures to
            // assets/textures/celestial/planets/dwarf/ and register them here.
            "textures/celestial/planets/dwarf/4k_ceres.jpg",
            "textures/celestial/planets/haumea_4k.jpg",
            "textures/celestial/planets/makemake_4k.jpg",
            "textures/celestial/planets/eris_2k.jpg",
            "textures/celestial/planets/pluto_8k.png",
            // generic fallbacks for procedural asteroids
            "textures/celestial/asteroids/generic_s_type_2k.jpg",
            "textures/celestial/asteroids/generic_c_type_2k.jpg",
        ],
        "moon": [
            "textures/celestial/moons/moon_8k.jpg",
            "textures/celestial/moons/europa_4k.png",
            "textures/celestial/moons/ganymede_4k.jpg",
            "textures/celestial/moons/callisto_4k.jpg",
            // titan_4k.jpg is a Cassini RADAR/SAR map (monochromatic, very dark) —
            // not a colour image, so it makes procedural moons look pitch-black.
            "textures/celestial/moons/triton_4k.jpg",
        ],
        "asteroid_s": [
            "textures/celestial/asteroids/generic_s_type_2k.jpg",
        ],
        "asteroid_c": [
            "textures/celestial/asteroids/generic_c_type_2k.jpg",
        ],
        "comet": [
            "textures/celestial/comets/generic_nucleus_2k.jpg",
        ],
