                // Ti at 25 TitaniumMines × 0.02 Mt/yr × 0.6 Earth
                // accessibility = 0.3 Mt/yr Ti production → 1,667 yr
                // payback. Hard blocker: the player can never build
                // an OrbitalLift. Dropping to 5 Mt gives a 16.7 yr
                // payback (tier-3 strategic, per the v3.1 cost curve).
                // Real-world space elevator Ti requirement is ~0.1 Mt
                // per cable (USGS / NASA 2024), so 5 Mt is still
                // 50× the real figure — calibrated for tier-3 pacing.
                ("Titanium", 5.0),
                ("Iron", 333.0),
                ("RareEarths", 83.0),
                ("Carbon", 167.0),
            ],
            maintenance_resources: [
                ("Titanium", 0.02),
                ("Iron", 0.5),
                ("Carbon", 0.05),
                ("RareEarths", 0.001),
                ("Copper", 0.003883),
            ],
            modifiers: [
                // v3.6: LogisticsCapacity per OrbitalLift = 20,000 t/yr
                // (Earth-to-orbit; 4× MassDriver — the most efficient
                // ground-to-orbit option). Authoritative value moved
                // to RON from hard-code.
                (modifier_type: "LogisticsCapacity", value: 20000.0),
            ],
            power_demand_mw: 1200,
