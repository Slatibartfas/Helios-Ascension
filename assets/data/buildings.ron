// Building definitions for Helios Ascension
//
// This file defines all building types, their costs, prerequisites, and effects.
//
// Modding Guide:
// - Add new buildings by copying an existing entry and changing the fields.
// - `id` must match a BuildingType enum variant name (e.g. "Mine", "DeepDrill").
// - `resource_costs` lists resources consumed from the global stockpile on construction.
// - `maintenance_resources` lists resources consumed per year to keep the building running.
//   Audit (GRA-22a): every building has 4–6 distinct resources; disabling a resource
//   must noticeably weaken or shut down the building.
// - `required_tech` is the tech ID that must be researched to unlock the building (empty = always available).
// - `modifiers` apply global bonuses when the building is operational. Per-build
//   values are calibrated so that ONE in-game building on Earth ≈ 2026 world
//   production total for the dominant resource (operator binding criterion).
//   Reference numbers are cited inline for audit. Earth × 1.0 yield totals
//   are preserved by construction-side count adjustments in GRA-22b.
// - `build_points`, `workforce`, `category`, `icon`, `description` control display and simulation.
//
// Schema fields:
// - `population_scale_multiplier` (top-level, f64) is the colony-population /
//   per-build worker-unit conversion factor. Read by Rust as `pub const` in GRA-22b.
// - `colony_constants` (top-level, struct) holds the colony-level tuning
//   parameters that used to be hard-coded in `src/colony/components.rs`
//   (food consumption per capita, base growth rate, workforce fraction, etc.).
//   v3.6 moved these to RON so the data file is the single source of truth.
//   v3.7 added `per_capita_consumption_*` fields so the population
//   drives the consumer economy (real-world per-capita data from
//   USGS 2024 / worldsteel 2024 / OECD 2024 / WNA 2024 / NMA 2024).
//   v3.7 also added `food_decline_*` for the gradual growth-to-decline
//   transition when food production falls below demand.

(
    population_scale_multiplier: 100.0,
    colony_constants: (
        // Per-capita food consumption. FAO 2024 SOFA: 1,100 kg/person/year
        // = 0.0000011 Mt/person/year. (1 Mt = 10⁹ kg.)
        food_consumption_per_capita_mt_per_year: 0.0000011,
        // Population growth parameters (per `population_growth_per_year`).
        // Base rate matches Earth 2026 demographic baseline (0.9%/yr).
        base_growth_rate: 0.009,
        // Medical centre growth bonus (capped).
        medical_growth_per_center: 0.0003,
        max_medical_growth_bonus: 0.009,
        // Housing utilisation: at 100% full, growth = (1 - 0.8) = 0.2×.
        housing_utilization_penalty: 0.8,
        // Available workforce: ~40% of population is working-age and willing.
        available_workforce_fraction: 0.4,
        // Operating cost as fraction of build cost per year.
        operating_cost_fraction: 0.05,
        // v3.7.1 (steeper curve): food-driven growth formula.
        // Growth factor = (2*ratio - 1)^1.5 for ratio in [0.5, 1.0],
        // 0 below 0.5, 1 above 1.0. Power 1.5 (not sqrt) makes
        // the curve feel pressure earlier:
        //   ratio 0.95 → factor 0.85  (5% deficit → 15% slowdown)
        //   ratio 0.85 → factor 0.59  (15% deficit → 41% slowdown)
        //   ratio 0.70 → factor 0.25  (30% deficit → 75% slowdown)
        //   ratio 0.50 → factor 0.00  (50% deficit → 0% growth)
        // Calibrated to give IPC-level-style feedback (Lanz 2016,
        // Ó Gráda 2009, Sen 1981): level 2 (Stressed) at 0.95,
        // level 3 (Crisis) at 0.85, level 4 (Emergency) at 0.7,
        // level 5 (Famine) at 0.5. Real-world data shows 0.5-3% per
        // year mortality in moderate food insecurity and 1-5%
        // peak in famines, so max mortality = 3%/yr is realistic.
        // Threshold 0.95 (was 0.70 in v3.7 first attempt) so the
        // player sees feedback from any deficit, not just severe
        // famine. Combined with the steeper growth-factor curve,
        // the player should rarely see <0.5 because they're warned
        // at 0.95.
        food_decline_threshold: 0.95,
        food_decline_max_mortality: 0.03,

        // v3.7: per-capita consumer consumption. Sums across the
        // colony's population to drive the consumer economy. Each
        // value is in Mt/person/year (1 Mt = 10⁹ kg; 1 kg = 10⁻⁹ Mt).
        // Calibrated so 8.2B people consume ~70% of USGS 2024 /
        // OECD 2024 / worldsteel 2024 world demand; the remaining
        // ~30% goes to industry, maintenance, feedstock, and power.
        per_capita_consumption: (
            // Iron (steel). worldsteel 2024: 214.7 kg finished
            // steel / p / yr × 0.97 Fe = 208 kg Fe / p / yr.
            // 8.2B × 2.13e-7 = 1,747 Mt ≈ 70% of 2,500 Mt world.
            iron_mt_per_year: 0.000000213,
            // Copper. USGS NMA 2024: 12 lbs / p / yr US ≈ 5.4 kg;
            // world ~3 kg. Scaled to 70% = 1.88 kg / p / yr.
            copper_mt_per_year: 0.0000000019,
            // Aluminum. USGS 2024: 70 Mt world / 8.2B = 8.5 kg.
            // Scaled to 70% = 5.98 kg / p / yr.
            aluminum_mt_per_year: 0.000000006,
            // Silicates (sand/gravel/aggregate). USGS NMA 2024:
            // 16,284 lbs / p / yr US; world ~410 kg / p / yr.
            silicates_mt_per_year: 0.00000041,
            // Titanium (TiO₂). v3.8.10 (2026-08-07): Ti is 100%
            // industrial (TiO₂ pigment, aerospace alloys, medical
            // implants) — real per-capita Ti consumption is
            // essentially zero. Set to 0 (matches the Rust
            // `PerCapitaConsumption` default; previously the RON
            // overrode it back to 1.1 kg/p/yr and Earth burned
            // 9 Mt/yr of Ti against an 9 Mt/yr world).
            titanium_mt_per_year: 0.0,
            // Polymers (plastics). OECD 2024: 450 Mt world / 8.2B = 55 kg.
            // Scaled to 70% = 38 kg / p / yr.
            polymers_mt_per_year: 0.000000038,
            // Phosphorus (P₂O₅ fertilizer). USGS 2024: 55 Mt world
            // / 8.2B = 6.7 kg. Scaled to 70% = 18.8 kg / p / yr.
            phosphorus_mt_per_year: 0.0000000188,
            // Sulfur. USGS 2024: 70 Mt world / 8.2B = 8.5 kg.
            // Scaled to 70% = 6 kg / p / yr.
            sulfur_mt_per_year: 0.000000006,
            // Nitrogen. v3.8.13 (2026-08-09): per-capita N₂ → 0. Real
            // people do NOT consume N₂ directly — the old 19 kg/p/yr
            // value was a "fertilizer proxy" hack. Fertilizer-N demand
            // now flows through the real chain: AmmoniaSynthesis draws
            // N₂ as the Haber-Bosch input, and the ammonia output is
            // consumed as fertilizer maintenance by Farm / Greenhouse
            // / Aquaculture / AgriDome. N₂ is a genuine industrial
            // loop, not a consumer good.
            nitrogen_mt_per_year: 0.0,
            // Methane (natural gas, IEA 2026: 4,100 bcm world /
            // 8.2B = 500 m³ / p / yr; ~50% consumer share).
            methane_mt_per_year: 0.00000025,
            // Uranium (WNA 2024: 74 kt world). v3.8.9
            // (2026-08-07): per-capita U is nonsensical — U is
            // 100% nuclear-power industrial, not a consumer good.
            // Set to 0 (matches the Rust `PerCapitaConsumption`
            // default; previously the RON overrode it back to 6.3
            // g/p/yr and Earth burned ~52 kt/yr against 74 kt/yr
            // production).
            uranium_mt_per_year: 0.0,
            // Carbon (coal/feedstock). USGS NMA 2024: 2,414 lbs
            // coal / p / yr US ≈ 1,095 kg. World ~700 kg / p / yr
            // (NMA is US only). 70% of 8,200 Mt = 700 kg / p / yr.
            carbon_mt_per_year: 0.0000007,
        ),
    ),

    buildings: [
        // ========================================
        // INFRASTRUCTURE
        // ========================================
        (
            id: "LifeSupport",
            display_name: "Life Support",
            description: "Converts local volatiles into breathable atmosphere",
            icon: "textures/ui/buildings/life-support.png",
            category: "Infrastructure",
            build_points: 500.0,
            workforce: 2000,
            required_tech: "",
            resource_costs: [
                ("Iron", 83.0),
                ("Copper", 33.0),
            ],
            maintenance_resources: [
                ("Water", 5.0),
                ("Oxygen", 1.3333),
                ("Polymers", 0.005),
                ("Nitrogen", 0.5),
                ("CarbonDioxide", 0.8),
            ],
            modifiers: [],
            power_demand_mw: 300,
        ),
        (
            id: "HabitatDome",
            display_name: "Habitat Dome",
            description: "Pressurised arcology housing ~50M residents",
            icon: "textures/ui/buildings/habitat-dome.png",
            category: "Infrastructure",
            build_points: 800.0,
            workforce: 1000,
            required_tech: "",
            resource_costs: [
                ("Iron", 167.0),
                ("Silicates", 133.0),
                ("Aluminum", 50.0),
            ],
            maintenance_resources: [
                ("Iron", 1.0),
                ("Polymers", 0.01),
                ("Magnesium", 0.003125),
                ("Water", 2.0),
                ("Oxygen", 0.66667),
                ("Nitrogen", 0.5),
            ],
            modifiers: [
                // Authoritative value lives in `Colony::housing_capacity` at
                // src/colony/components.rs:264 (50,000,000 per HabitatDome).
                // This RON entry is human-readable documentation; the helper
                // does not read it.  See GRA-127 / Phase B-1, GRA-133, GRA-338.
                //
                // v3.2 canary 12 (2026-08-07): synced RON to match
                // the simulation's hard-coded value at
                // `src/colony/components.rs:298`. Before this fix the
                // `friendly_label` (canary 11) was reading the RON
                // (4,000,000,000) and showing "Houses 4.00B residents"
                // on the card, while the simulation actually used
                // 50,000,000 — a 80× mismatch. Card and sim now agree.
                //
                // Tier role: metropolitan (above Housing Complex,
                // below arcology).  At this scale Earth needs ~164
                // Habitat Domes to reach its 8.2B seed — within the
                // v2 manageable-count band (10–50 was the target;
                // 164 is the v0.5.0 design choice per
                // `src/colony/components.rs:291`).
                //
                // For new colonies on airless bodies, see the
                // v3.2 starter-tier `HabitatTent` (1k) and
                // `HabitatModule` (10k) — these are the first
                // buildings the player can build on a fresh outpost.
                (modifier_type: "HousingCapacity", value: 50000000.0),
            ],
            power_demand_mw: 225,
        ),
        (
            id: "Housing",
            display_name: "Housing Complex",
            description: "City-block-scale residential complex, housing ~25M residents",
            icon: "textures/ui/buildings/housing.png",
            category: "Infrastructure",
            build_points: 200.0,
            workforce: 500,
            required_tech: "",
            resource_costs: [
                ("Iron", 33.0),
                ("Silicates", 83.0),
            ],
            maintenance_resources: [
                ("Iron", 0.001),
                ("Polymers", 0.002),
                ("Water", 0.5),
                ("Copper", 0.00019415),
                ("Sulfur", 0.00023333),
            ],
            modifiers: [
                // Authoritative value lives in `Colony::housing_capacity` at
                // src/colony/components.rs:264 (25,000,000 per Housing).  At
                // this scale Earth needs ~335 Housing Complexes to reach its
                // 8.2B seed, matching the calibration target from GRA-22a
                // (one colony building ≈ 1/300 of world population).  This
                // RON entry is human-readable documentation; the helper does
                // not read it.  See GRA-127 / Phase B-1, GRA-133, GRA-338.
                //
                // v3.2 canary 12 (2026-08-07): synced RON to match
                // the simulation at `src/colony/components.rs:298`
                // (25,000,000 per Housing Complex). Before this fix
                // the card showed "Houses 800M residents" while the
                // sim used 25M — a 32× mismatch.
                //
                // Tier role: the workhorse metropolitan residential
                // complex (~25M residents = a Tokyo-class metro area).
                // For starter-scale colonization, see v3.2
                // `HabitatTent` (1k) and `HabitatModule` (10k).
                (modifier_type: "HousingCapacity", value: 25000000.0),
            ],
            power_demand_mw: 75,
        ),
        (
            id: "UndergroundHabitat",
            display_name: "Underground Habitat",
            description: "Buried habitat for airless or hostile bodies, housing ~30M residents",
            icon: "textures/ui/buildings/underground-habitat.png",
            category: "Infrastructure",
            build_points: 1200.0,
            workforce: 1500,
            required_tech: "",
            resource_costs: [
                ("Iron", 250.0),
                ("Silicates", 167.0),
                ("Titanium", 83.0),
            ],
            maintenance_resources: [
                ("Iron", 2.0),
                ("Polymers", 0.008),
                ("Water", 1.0),
                ("Oxygen", 0.33333),
                ("Titanium", 0.002),
                ("Nitrogen", 0.2),
            ],
            modifiers: [
                // v3.2 canary 12 (2026-08-07): synced RON to match
                // the simulation at `src/colony/components.rs:298`
                // (30,000,000 per UndergroundHabitat). Before this
                // fix the card showed "Houses 2.00B residents" while
                // the sim used 30M — a 67× mismatch.
                //
                // Tier role: buried metropolitan habitat for
                // airless / hostile bodies (Moon, Mars underground,
                // Mercury, asteroid interiors). At this scale a body
                // seeded to 1B needs ~33 UndergroundHabitats. For
                // starter-scale colonization, see v3.2
                // `HabitatTent` (1k) and `HabitatModule` (10k).
                (modifier_type: "HousingCapacity", value: 30000000.0),
            ],
            available_atmospheres: [None],
            power_demand_mw: 450,
        ),

        // ========================================
        // STARTER-TIER HOUSING (v3.2 canary 12)
        // ========================================
        // For new colonies on airless bodies (Moon, Mars, asteroid).
        // The smallest existing housing (Housing Complex, 25M residents)
        // is "metropolitan tier" — too big for a 100k-population new
        // colony. The two buildings below are the first buildings the
        // player can actually USE on a fresh outpost.
        (
            id: "HabitatTent",
            display_name: "Habitat Tent",
            description: "Inflatable emergency shelter, 1,000 residents. First building on a new colony.",
            icon: "textures/ui/buildings/habitat-tent.png",
            category: "Infrastructure",
            build_points: 50.0,
            workforce: 5,
            required_tech: "",
            resource_costs: [
                ("Iron", 3.0),
                ("Silicates", 5.0),
            ],
            maintenance_resources: [
                ("Water", 0.05),
                ("Polymers", 0.001),
                ("Iron", 0.0001),
                ("Nitrogen", 0.001),
            ],
            modifiers: [
                (modifier_type: "HousingCapacity", value: 1000.0),
            ],
            power_demand_mw: 5.0,
        ),
        (
            id: "HabitatModule",
            display_name: "Habitat Module",
            description: "Prefab habitat module, 10,000 residents. Second-tier starter for growing colonies.",
            icon: "textures/ui/buildings/habitat-module.png",
            category: "Infrastructure",
            build_points: 200.0,
            workforce: 50,
            required_tech: "",
            resource_costs: [
                ("Iron", 10.0),
                ("Silicates", 15.0),
                ("Copper", 1.0),
                ("Aluminum", 3.0),
            ],
            maintenance_resources: [
                ("Water", 0.5),
                ("Polymers", 0.005),
                ("Iron", 0.001),
                ("Copper", 3.883e-05),
                ("Nitrogen", 0.005),
            ],
            modifiers: [
                (modifier_type: "HousingCapacity", value: 10000.0),
            ],
            power_demand_mw: 30.0,
        ),

        (
            id: "Factory",
            display_name: "Factory",
            description: "Regional megafactory. Provides +10 BP/yr to the colony's construction queue (per Factory).",
            icon: "textures/ui/buildings/factory.png",
            category: "Industry",
            build_points: 1000.0,
            workforce: 12000,
            required_tech: "",
            resource_costs: [
                ("Iron", 250.0),
                ("Copper", 83.0),
                ("Aluminum", 83.0),
                ("Nickel", 33.0),
            ],
            maintenance_resources: [
                ("Iron", 0.05),
                ("Copper", 0.0019415),
                ("Lithium", 2.3634e-05),
                ("Polymers", 0.003),
                // v3.8.13: oxygen for basic-oxygen-furnace (BOF)
                // steelmaking — 0.1 Mt/yr × 1,200 = 120 Mt/yr, the
                // steel-industry O₂ share of the 150 Mt/yr world.
                ("Oxygen", 0.1),
            ],
            modifiers: [
                // v3.1 canary 11 (2026-08-06): the legacy
                // `ConstructionCost: -200.0` was a GRA-22b transition
                // placeholder. The Rust at `src/colony/systems.rs:96`
                // actually does `1.0 + factories * 10.0` BP/yr — i.e.
                // 1 BP/yr base + 10 BP/yr per Factory. Renamed the
                // modifier to `BuildPointsProduction: 10.0` so the
                // build card displays the actual effect ("Builds
                // +10 BP/yr") instead of the misleading
                // "ConstructionCost -200" line. The Rust formula is
                // unchanged (still hard-coded at systems.rs:96); the
                // RON value is documentation + the card display.
                (modifier_type: "BuildPointsProduction", value: 10.0),
                // v3.6: WealthGeneration per-Factory = 100 MC/yr
                // (manufactured-goods revenue). Authoritative value
                // moved to RON from hard-code at
                // `src/colony/components.rs:wealth_generation_per_year`.
                (modifier_type: "WealthGeneration", value: 100.0),
            ],
            power_demand_mw: 1200,
        ),
        (
            id: "AtmosphericProcessor",
            display_name: "Atmospheric Processor",
            description: "Harvests industrial gases (N₂ + O₂ + Ar + CO₂) for the colony. v3.8.12: per-gas rates sized so 300 processors (Earth start) produce the 2026 world demand — N₂ 0.667, O₂ 0.5, Ar 0.00333, CO₂ 0.667 Mt/yr per build = 200 / 150 / 1 / 200 Mt/yr.",
            icon: "textures/ui/buildings/atmospheric-processor.png",
            category: "Industry",
            build_points: 500.0,
            workforce: 3000,
            required_tech: "",
            resource_costs: [
                ("Iron", 67.0),
                ("Copper", 33.0),
                ("Aluminum", 33.0),
            ],
            maintenance_resources: [
                ("Iron", 0.01),
                ("Copper", 0.0019415),
                ("Aluminum", 0.001),
                ("Water", 0.05),
                ("Polymers", 0.001),
                ("Fluorine", 0.0005),
            ],
            modifiers: [
                // v3.8.12 (2026-08-08): per-gas production modifiers
                // (N₂ / O₂ / Ar / CO₂). Replaces the old single
                // `AtmosphericHarvesting` modifier with concentration-
                // weighted share-fold (see commit `c1c8807` for
                // context). The share-fold over-produced N (78% of
                // atmosphere but only 48% share under the deposit-
                // concentration weights in profiles.rs) and wildly
                // under-produced CO₂ (0.04% of atmosphere = 0.2% of
                // demand), and over-produced Ar (775% of demand).
                //
                // Per-build rates sized so 300 AtmosphericProcessors
                // (Earth starting count) produces exactly the world
                // 2026 demand for each gas (Linde / Air Liquide 2024):
                //   - N:   200 / 300 = 0.667   Mt/yr/build
                //   - O:   150 / 300 = 0.500   Mt/yr/build
                //   - Ar:    1 / 300 = 0.00333 Mt/yr/build
                //   - CO₂: 200 / 300 = 0.667   Mt/yr/build
                // The "operator bar" the v3.8.10 comment invoked
                // (1 processor ≈ world share) is now per-gas: 1/300 of
                // each gas's world demand, not 1/300 of the mixed
                // share-folded total.  This is the design §5.18 /
                // §8.3.6 split that BALANCE_PATCHES_v0.5.md
                // documented as PENDING.
                (modifier_type: "NitrogenProduction", value: 0.667),
                (modifier_type: "OxygenProduction", value: 0.5),
                (modifier_type: "ArgonProduction", value: 0.00333),
                (modifier_type: "CarbonDioxideProduction", value: 0.667),
            ],
            power_demand_mw: 600,
        ),
        (
            id: "ChemicalPlant",
            display_name: "Chemical Plant",
            description: "Industrial chemistry at world scale. H₂ (SMR from methane) + NH₃ (Haber-Bosch from N₂ + H₂) + polymers (methane cracker) + Tritium breeding. Capacity: H₂ 100, NH₃ 200, polymers 450 Mt/yr; Earth fertilizer chain consumes ~135 Mt/yr NH₃.",
            icon: "textures/ui/buildings/chemical-plant.png",
            category: "Industry",
            build_points: 800.0,
            workforce: 4000,
            required_tech: "",
            resource_costs: [
                ("Iron", 133.0),
                ("Copper", 50.0),
                ("Silicates", 33.0),
                ("Sulfur", 17.0),
            ],
            maintenance_resources: [
                ("Iron", 0.02),
                ("Copper", 0.003883),
                ("Sulfur", 0.014),
                ("Phosphorus", 0.0005),
                ("Fluorine", 0.001),
                // v3.8.13: CO₂ feedstock (urea/chemicals) — 0.1 Mt/yr
                // × 700 = 70 Mt/yr of the 200 Mt/yr world industrial CO₂.
                ("CarbonDioxide", 0.1),
            ],
            modifiers: [
                // v3.8.4: per-build production calibrated at
                // 1 plant ≈ world_demand / (N_plants × access) so the
                // starting count exactly matches 1× world demand
                // (CLAUDE.md operator bar for Tier 2).  Earth has
                // 700 ChemicalPlant, access = 0.6, so:
                //   - Hydrogen (commercial): 100 Mt/yr / 700 / 0.6 = 0.238 Mt/yr/build
                //   - Ammonia: 200 Mt/yr / 700 / 0.6 = 0.476 Mt/yr/build
                //   - Polymers: 450 Mt/yr / 700 / 0.6 = 1.071 Mt/yr/build
                // The previous calibration (100/200/450) was 1 plant =
                // world demand, which with 700 ChemicalPlants overproduced
                // by 300× and starved downstream processes
                // (PolymerSynthesis couldn't run because Methane was
                // over-allocated to HydrogenSynthesis + AmmoniaSynthesis).
                // v3.8.10 (2026-08-07): 700 plants × 0.238 × 0.6 = 100 Mt H2
                // (matches world), but the access multiplier is wrong here
                // because ChemicalPlant is a Tier 2 industrial facility, not
                // a mine.  Synthesis doesn't depend on deposit accessibility.
                // Removing the 0.6 access for these three modifiers:
                //   - H2:  0.238 / 0.6 = 0.397  → use 0.143 (700 × 0.143 = 100 Mt)
                //   - NH3: 0.476 / 0.6 = 0.794  → use 0.286 (700 × 0.286 = 200 Mt)
                //   - Pol: 1.071 / 0.6 = 1.785  → use 0.643 (700 × 0.643 = 450 Mt)
                // This is a "v3.8.10 design correction": the 0.6 access
                // multiplier was double-counted in v3.8.4.  Per CLAUDE.md
                // operator bar, 1 ChemicalPlant ≈ 1/300 of world, so 700
                // plants = 2.33× world → at full utilization produces 2.33×
                // 2026 demand.  We scale the per-build to land at exactly 1×
                // (so the cap throttles overflow once player builds more
                // plants).
                (modifier_type: "HydrogenSynthesis", value: 0.143),
                (modifier_type: "AmmoniaSynthesis", value: 0.286),
                (modifier_type: "PolymerSynthesis", value: 0.643),
                // Tritium breeding is only active once `fusion_power` is unlocked.
                // 2026: 0 (no commercial fusion yet); game-unlock target 0.05 Mt/yr.
                (modifier_type: "TritiumBreeding", value: 0.05),
            ],
            power_demand_mw: 900,
        ),
        // ========================================
        
        // ========================================
        // v0.5.1 + v0.5.2 MINES (per-resource dedicated)
        // ========================================
        // v0.5.2: each base mine produces ONE resource at
        // `base_yield × deposit.accessibility × yield_mult` Mt/yr.
        // The legacy tier system (MiningEfficiency / share-fold) is
        // gone — see `src/economy/mining.rs` extract_resources.
        //
        // Body restrictions:
        //   He3Mine: [Moon, GasGiant, Asteroid] (canary 3 — lunar regolith
        //            + gas-giant primordial He-3)
        //   AutoXxx: [Asteroid, Moon, GasGiant] (orbital mining only)
        //
        // Calibration: 25 × base_yield × deposit.accessibility
        //   ≈ USGS 2024 / 2026 world demand. Each per-build value is
        //   world / (25 × real Earth deposit accessibility from
        //   `src/economy/profiles.rs` "Earth" profile) — see
        //   BALANCE_PATCHES_v0.5.md §5 and the v3.8.12 addendum.
        // Construction materials (9)
        (
