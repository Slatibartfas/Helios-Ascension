            build_points: 500.0,
            workforce: 2000,
            required_tech: "",
            resource_costs: [
                ("Iron", 83.0),
                ("Copper", 33.0),
            ],
            maintenance_resources: [
                ("Water", 5.0),
                ("Oxygen", 2.0),
                ("Polymers", 0.005),
                ("Nitrogen", 0.5),
                ("CarbonDioxide", 0.8),
            ],
            modifiers: [],
            power_demand_mw: 200.0,
        ),
        (
            id: "HabitatDome",
            display_name: "Habitat Dome",
            description: "Pressurised arcology housing ~50M residents",
            icon: "🏠",
            category: "Infrastructure",
            build_points: 800.0,
            workforce: 1000,
            required_tech: "",
            resource_costs: [
                ("Iron", 167.0),
                ("Silicates", 133.0),
                ("Aluminum", 50.0),
            ],
            maintenance_resources: [
                ("Iron", 1.0),
                ("Polymers", 0.01),
                ("Magnesium", 0.005),
                ("Water", 2.0),
                ("Oxygen", 1.0),
                ("Nitrogen", 0.5),
            ],
            modifiers: [
                // Authoritative value lives in `Colony::housing_capacity` at
                // src/colony/components.rs:264 (50,000,000 per HabitatDome).
                // This RON entry is human-readable documentation; the helper
                // does not read it.  See GRA-127 / Phase B-1, GRA-133, GRA-338.
                //
                // Tier role: large pressurised arcology (above Housing Complex,
                // below true megacity).  At this scale Earth needs ~165 Habitat
                // Domes to reach its 8.2B seed.  Combined with the Housing
                // Complex count the player manages tens to low-hundreds of
                // residential buildings per body — never the thousands-of-clicks
                // count GRA-338 explicitly rules out (operator guideline).
                (modifier_type: "HousingCapacity", value: 4000000000.0),
            ],
            power_demand_mw: 150.0,
        ),
        (
            id: "Housing",
            display_name: "Housing Complex",
            description: "City-block-scale residential complex, housing ~25M residents",
            icon: "🏙",
            category: "Infrastructure",
            build_points: 200.0,
            workforce: 500,
            required_tech: "",
            resource_costs: [
                ("Iron", 33.0),
                ("Silicates", 83.0),
            ],
            maintenance_resources: [
                ("Iron", 0.001),
                ("Polymers", 0.002),
                ("Water", 0.5),
                ("Copper", 0.0005),
                ("Sulfur", 0.0005),
            ],
            modifiers: [
                // Authoritative value lives in `Colony::housing_capacity` at
                // src/colony/components.rs:264 (25,000,000 per Housing).  At
                // this scale Earth needs ~335 Housing Complexes to reach its
                // 8.2B seed, matching the calibration target from GRA-22a
                // (one colony building ≈ 1/300 of world population).  This
                // RON entry is human-readable documentation; the helper does
                // not read it.  See GRA-127 / Phase B-1, GRA-133, GRA-338.
                //
                // Tier role: the workhorse city-block residential complex.
                // Cross-reference: docs/COLONIES.md has the same tier curve
                // (HabitatDome / Housing / UndergroundHabitat) in tabular form.
                // Modders changing this value should also update the
                // authoritative helper and the docs/COLONIES.md row.
                (modifier_type: "HousingCapacity", value: 800000000.0),
            ],
            power_demand_mw: 50.0,
        ),
        (
