// SFX manifest — moddable surface for sound-effect cues.
//
// Each entry is one named cue. The runtime `SfxPlugin`
// (src/plugins/sfx.rs) loads this on `Startup`, resolves the
// `file` path under `assets/audio/sfx/`, and registers a
// `Handle<AudioSource>` per cue in `SfxRegistry`.
//
// **Moddability**: to override an existing cue, drop a `.wav`
// into `assets/audio/sfx/` with the same `file` name and
// (optionally) tweak `default_volume` / `cooldown_ms` here. To
// add a new cue, append an entry below *and* add the matching
// `SfxCueId` variant in `src/plugins/sfx.rs` (the audit script
// `scripts/audit_sfx_manifest.py` enforces this).
//
// **Schema**: `SfxCategory` is the same enum used internally
// for per-category volume routing (mirrors the categories in
// `assets/data/notifications.ron`). `default_volume` is a
// linear multiplier on top of the player's `sfx_volume` master
// slider; values are typically 0.5–1.0. `cooldown_ms` is the
// minimum interval between successive plays of the same cue
// (prevents button-mash saturation). `prompt` is the natural-
// language brief fed to the MiniMax Audio generator — see
// `assets/data/sfx_prompts.ron` for the canonical prompts used
// to produce the bundled WAVs.
//
// **Phase 1 surface**: 13 UI cues + 1 universal notification
// chime. Construction / research / shipbuilding / fleet /
// survey / launch / time-control cues are added in later PRs
// (see `/memories/session/plan.md` for the full roadmap).
(
    cues: [
        // ── UI chrome ─────────────────────────────────────────────
        (
            id: "ui.button_click",
            file: "ui_button_click.wav",
            category: Ui,
            default_volume: 0.7,
            cooldown_ms: 50,
            prompt: "Cold metallic pushbutton click, 80ms. Brushed steel actuator — sharp mechanical snap, dry close-mic'd transients, zero reverb. Like a recessed avionics key in a vacuum-rated console.",
        ),
        (
            id: "ui.tab_switch",
            file: "ui_tab_switch.wav",
            category: Ui,
            default_volume: 0.6,
            cooldown_ms: 80,
            prompt: "Industrial relay throw, 120ms. Heavy-duty latching solenoid in a sealed enclosure — clunk of a magnetic contact closing. Lower, drier, more mechanical than ui_button_click.",
        ),
        (
            id: "ui.panel_open",
            file: "ui_panel_open.wav",
            category: Ui,
            default_volume: 0.65,
            cooldown_ms: 200,
            prompt: "Hydraulic actuator extending, 280ms. A heavy blast door cycling open — pressurised hiss bleeding into a mechanical servo lock. Mid-frequency, no whoosh, no air-sweep fantasy. Just mass and force.",
        ),
        (
            id: "ui.panel_close",
            file: "ui_panel_close.wav",
            category: Ui,
            default_volume: 0.65,
            cooldown_ms: 200,
            prompt: "Hydraulic actuator retracting, 240ms. Blast door sealing shut — servo lock engaging with a definitive mechanical thud. Mirror character of ui_panel_open, faster decay.",
        ),
        (
            id: "ui.slider_tick",
            file: "ui_slider_tick.wav",
            category: Ui,
            default_volume: 0.5,
            cooldown_ms: 40,
            prompt: "Encoder detent pulse, 60ms. A precise notched-wheel click under a metal stylus. Mechanical, mid-high, dry. Like a detented rotary encoder on a spacecraft instrument panel.",
        ),
        (
            id: "ui.dropdown_open",
            file: "ui_dropdown_open.wav",
            category: Ui,
            default_volume: 0.6,
            cooldown_ms: 150,
            prompt: "Mechanical detent popup, 140ms. A hinged metal cover flipping open with a spring-loaded snap — like a flip-up guarded switch on a military radio. Mid-pitched, decisive, no chirp.",
        ),
        (
            id: "ui.row_select",
            file: "ui_row_select.wav",
            category: Ui,
            default_volume: 0.55,
            cooldown_ms: 80,
            prompt: "Targeting computer lock tone, 100ms. A muted two-tone metallic ping — like a weapons console acknowledging target selection. Tonal (not percussive), brief sustain, no melodic sweetness.",
        ),
        (
            id: "ui.drag_drop",
            file: "ui_drag_drop.wav",
            category: Ui,
            default_volume: 0.7,
            cooldown_ms: 120,
            prompt: "Magnetic coupling engagement, 180ms. A heavy industrial bolt-latch snapping into its receiver — steel shoe locking into a hard mount. Solid low-mid, satisfying weight.",
        ),
        (
            id: "ui.modal_confirm",
            file: "ui_modal_confirm.wav",
            category: Ui,
            default_volume: 0.75,
            cooldown_ms: 200,
            prompt: "Armed detonator confirmation, 320ms. Two descending tones in a tight interval — like an arming switch throwing + a solenoid latching into 'READY'. Authoritative, decisive, slightly ominous.",
        ),
        (
            id: "ui.modal_cancel",
            file: "ui_modal_cancel.wav",
            category: Ui,
            default_volume: 0.75,
            cooldown_ms: 200,
            prompt: "Disarm confirmation, 280ms. A muted descending two-tone, lower and softer than ui_modal_confirm. Like a safety cover snapping back over an arming switch. No musical sweetness.",
        ),
        (
            id: "ui.chip_toggle",
            file: "ui_chip_toggle.wav",
            category: Ui,
            default_volume: 0.55,
            cooldown_ms: 60,
            prompt: "Toggle switch throw, 70ms. A guarded micro-switch clicking on/off — military-spec toggle, dry, mid-high. Symmetric: on and off sound identical (state is conveyed visually).",
        ),
        (
            id: "ui.mode_toggle",
            file: "ui_mode_toggle.wav",
            category: Ui,
            default_volume: 0.7,
            cooldown_ms: 150,
            prompt: "Mode-selector detent, 160ms. A heavy rotary knob clicking into a new detent position — like a 4-position weapons-selector switch on a hard-mounted console.",
        ),

        // ── Notifications (universal chime) ────────────────────────
        // Plays once per *coalesced* toast (see
        // src/plugins/sfx/bridges/notifications.rs). Cooldown is
        // long enough that a burst of toasts yields at most one
        // chime per second.
        (
            id: "notifications.chime",
            file: "notifications_chime.wav",
            category: Notifications,
            default_volume: 0.7,
            cooldown_ms: 1000,
            prompt: "Comms-channel incoming alert, 600ms. A two-tone metallic ping over a low hum — like an intercom opening on a ship's bridge, or a comms officer's headset registering an incoming transmission. Not a bell, not an arpeggio — a station hailing you.",
        ),
    ],
)